{
  "name": "dotwo-vtr",
  "version": "0.2.0",
  "description": "Desktop VTR app for local video/image playback on a second display.",
  "author": "Domingo Moreno / DoTwo",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/dotwobot-dev/dotwo-vtr.git"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "electron": "electron .",
    "check": "node --check electron/main.cjs && node --check electron/preload.cjs && node --check public/app.js && node --check public/display.js",
    "fetch:ffmpeg": "bash scripts/fetch_ffmpeg_macos.sh",
    "brand:build": "bash scripts/build_brand_assets.sh",
    "pack": "electron-builder --dir",
    "pack:mac-arm64": "electron-builder --dir --arm64 --config.directories.output=dist-arm64",
    "pack:mac-intel": "electron-builder --dir --x64 --config.directories.output=dist-intel",
    "pack:mac-legacy": "electron-builder --dir --x64 --config.electronVersion=26.6.10 --config.directories.output=dist-legacy --config.mac.minimumSystemVersion=10.13.0",
    "zip:mac-arm64": "electron-builder --arm64 --config.directories.output=dist-arm64",
    "zip:mac-intel": "electron-builder --x64 --config.directories.output=dist-intel",
    "zip:mac-legacy": "electron-builder --x64 --config.electronVersion=26.6.10 --config.directories.output=dist-legacy --config.mac.minimumSystemVersion=10.13.0",
    "beta:local": "bash scripts/package_local_beta_macos.sh arm64",
    "beta:local:arm64": "bash scripts/package_local_beta_macos.sh arm64",
    "beta:local:intel": "bash scripts/package_local_beta_macos.sh x64",
    "repo:bundle": "bash scripts/package_repo_bundle.sh",
    "nas:stage": "bash scripts/stage_nas_delivery.sh",
    "clean:builds": "bash scripts/clean_build_artifacts.sh",
    "release:mac": "bash scripts/release-mac.sh",
    "check:mac-signing": "node scripts/macos-signing.cjs",
    "release:mac:signed": "node scripts/release-mac-signed.cjs",
    "verify:mac-artifact": "node scripts/verify-mac-artifact.cjs",
    "build:dmg-background": "xcrun swift scripts/build-dmg-background.swift",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.dotwo.vtr",
    "productName": "DoTwo VTR",
    "files": [
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "scripts",
        "to": "scripts",
        "filter": ["*.sh", "!fetch_ffmpeg_macos.sh", "!package_local_beta_macos.sh", "!release-mac.sh", "!stage_nas_delivery.sh", "!clean_build_artifacts.sh"]
      },
      {
        "from": "vendor/ffmpeg/darwin-${arch}",
        "to": "bin/darwin-${arch}",
        "filter": ["ffmpeg", "ffprobe"]
      },
      {
        "from": "build/licenses",
        "to": "licenses"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "NOTICE",
        "to": "NOTICE"
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "dmg": {
      "background": "build/dmg/background.png",
      "icon": "build/icon.icns",
      "iconSize": 112,
      "iconTextSize": 13,
      "format": "UDZO",
      "contents": [
        { "x": 160, "y": 202, "type": "file" },
        { "x": 480, "y": 202, "type": "link", "path": "/Applications", "name": "Aplicaciones" }
      ]
    },
    "mac": {
      "category": "public.app-category.video",
      "identity": null,
      "icon": "build/icon.icns",
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.inherit.plist",
      "minimumSystemVersion": "10.15.0",
      "target": [
        "zip"
      ]
    }
  },
  "devDependencies": {
    "electron": "31.7.7",
    "electron-builder": "^26.8.1"
  }
}
